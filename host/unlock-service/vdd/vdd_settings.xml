<?xml version='1.0' encoding='utf-8'?>
<!--
  RemoteClaude 虚拟屏的驱动设置（docs/11-virtual-display.md）。安装脚本把它放进 Program Files\RemoteClaude\vdd，
  并在 HKLM\SOFTWARE\MikeTheTech\VirtualDisplayDriver 的 VDDPATH 里指向那个目录，驱动从那里读。
  在驱动自带的那份上改的：只要一块屏，只有 1920x1080、60Hz 一档（驱动默认用列表里的第一档），不写日志。
-->
<vdd_settings>
    <monitors>
        <count>1</count>
    </monitors>
    <gpu>
        <friendlyname>default</friendlyname>
    </gpu>
    <global>
        <g_refresh_rate>60</g_refresh_rate>
    </global>
    <resolutions>
        <resolution>
            <width>1920</width>
            <height>1080</height>
            <refresh_rate>60</refresh_rate>
        </resolution>
    </resolutions>
    <options>
        <CustomEdid>false</CustomEdid>
        <PreventSpoof>false</PreventSpoof>
        <EdidCeaOverride>false</EdidCeaOverride>
        <HardwareCursor>true</HardwareCursor>
        <SDR10bit>false</SDR10bit>
        <HDRPlus>false</HDRPlus>
        <logging>false</logging>
        <debuglogging>false</debuglogging>
    </options>
</vdd_settings>
